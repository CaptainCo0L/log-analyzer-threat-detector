# Copy to /mnt/Home/apps/pihole-detector/.env on the NAS, chmod 600. Never commit the real file.
# PIHOLE_PASSWORD is read from the Pi-hole stack's own .env, not from here.

# Telegram bot from @BotFather; chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Shadow mode: false = HIGH alerts are NOT pushed (JSONL + daily digest only).
PUSH_ENABLED=false
# Health alerts (Pi-hole API unreachable / recovered) are pushed even in shadow mode.
HEALTH_PUSH_ENABLED=true

# Optional threshold overrides (defaults in src/pihole_detector/config.py), e.g.
# NXDOMAIN_THRESHOLD=20
# TUNNEL_UNIQUE_SUBDOMAINS=50
# NOISY_APEXES=googlevideo.com,akamaihd.net

# Device names: the service probes known devices once a week (0 = Monday) just before that day's
# report and saves the answers to NAMES_FILE. `names --save` writes the same file by hand.
# DISCOVERY_WEEKDAY=0
# DISCOVERY_WAIT=10
# A new private MAC is asked its name, to tell a rotated phone MAC from a new device:
# ROTATION_PROBE_WAIT=3
# Devices those probes leave unnamed are nmapped for a TLS certificate / web page name (no root).
# NMAP_ENABLED=true
# NMAP_EXCLUDE=192.168.18.178,192.168.18.139
